# 复制为 .env 后按需修改。.env 不入库。
# 缺失必填项时应用**启动即报错**，不会带病运行。

APP_NAME=datadict
ENV=local
DEBUG=true

# ── 数据库 ──────────────────────────────────────────────────
# 必须使用 postgresql+asyncpg:// 协议。
# 两个 URL 必须是**不同的数据库角色**——相同时应用启动会直接拒绝，
# 因为那会让标注表的物理隔离失效（PRD §M10-8）。
DB_URL_WEB=postgresql+asyncpg://datadict_web:datadict_web_local@localhost:15432/datadict
DB_URL_COLLECTOR=postgresql+asyncpg://datadict_collector:datadict_collector_local@localhost:15432/datadict
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379/0

# ── 安全（生产从密钥管理系统注入，绝不入库）────────────────
# CREDENTIAL_SECRET_KEY 用于数据源连接凭证的 Fernet 加解密。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_SECRET_KEY=CHANGE_ME_local_dev_only_at_least_32_chars
JWT_SECRET_KEY=CHANGE_ME_local_dev_only_at_least_32_chars

# ── 采集 ────────────────────────────────────────────────────
SYNC_BATCH_SIZE=1000
SYNC_LOCK_TTL_SECONDS=3600
COLLECT_QUERY_TIMEOUT_SECONDS=60

# ── 检索 ────────────────────────────────────────────────────
# 注意：pg_trgm 相似度阈值是数据库级配置（ALTER DATABASE），不在这里。
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=200
