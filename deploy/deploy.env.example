# 复制为 deploy/.env 后填写（.env 已被 .gitignore 忽略，不入库）。
# 密码只用十六进制/字母数字，会被拼进连接串，避免 @ : / % 等字符。
# 生成：openssl rand -hex 16

POSTGRES_PASSWORD=
METAHUB_WEB_PASSWORD=
METAHUB_COLLECTOR_PASSWORD=

# Fernet 主密钥，加密数据源凭证。丢失后已录入的数据源密码无法解密，务必备份。
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_SECRET_KEY=

# JWT 签名密钥，至少 32 字符。生成：openssl rand -hex 32
JWT_SECRET_KEY=

# 对外访问端口（默认 8000）
APP_PORT=8000
